subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

environment  = "prod"
region       = "centralindia"
region_short = "cin"

# Public name of the KMS OIDC issuer; issuer URL = https://<gateway_hostname>/app/oidc
gateway_hostname = "kms.dc.example.org"

# Egress IP(s) of the machine/runner applying Terraform (Key Vault data plane).
key_vault_allowed_ip_ranges = ["203.0.113.10"]

# DC operator identities administering the ledger (object IDs). Empty = caller.
ledger_administrator_principal_ids = []

# GitHub environment allowed to run the Let's Encrypt renewal workflow.
ops_github_oidc_subjects = ["repo:prescera/depa-training-kms-azure:environment:dc-prod"]

tags = {
  owner = "dc-operations"
}
