{
  "name": "depa-training-kms",
  "version": "2.0.0",
  "private": true,
  "description": "DEPA Training v2 KMS: CCF JavaScript application for Azure Confidential Ledger",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && rollup --config && node build_bundle.js dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@microsoft/ccf-app": "6.0.1"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "22.15.19",
    "jest": "29.7.0",
    "rollup": "4.40.2",
    "ts-jest": "29.3.2",
    "tslib": "2.8.1",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "roots": ["<rootDir>/packages/depa-ccf-common/test", "<rootDir>/test/unit"],
    "setupFiles": ["<rootDir>/packages/depa-ccf-common/test/ccf-shim.ts"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": "tsconfig.test.json" }]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
